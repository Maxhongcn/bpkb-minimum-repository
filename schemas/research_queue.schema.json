{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BPKB Research Queue",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["research_id","trigger_type","trigger_reference","target_industry","target_modules","target_patterns","target_templates","research_questions","required_source_level","priority","status","assigned_to","output_pattern_ids","output_template_ids","notes","created_at","updated_at"],
    "properties": {
      "research_id": {"type": "string"},
      "trigger_type": {"type": "string", "enum": ["client_inquiry", "internal_strategy", "product_need", "delivery_feedback"]},
      "trigger_reference": {"type": "string"},
      "target_industry": {"type": "string"},
      "target_modules": {"type": "array", "items": {"type": "string"}},
      "target_patterns": {"type": "array", "items": {"type": "string"}},
      "target_templates": {"type": "array", "items": {"type": "string"}},
      "research_questions": {"type": "array", "items": {"type": "string"}},
      "required_source_level": {"type": "array", "items": {"type": "string", "enum": ["S", "A", "B", "C", "D", "E"]}},
      "priority": {"type": "string", "enum": ["A", "B", "C", "D"]},
      "status": {"type": "string", "enum": ["pending", "in_progress", "done", "archived"]},
      "assigned_to": {"type": "string", "enum": ["human", "chatgpt", "other"]},
      "output_pattern_ids": {"type": "array", "items": {"type": "string"}},
      "output_template_ids": {"type": "array", "items": {"type": "string"}},
      "notes": {"type": "string"},
      "created_at": {"type": "string", "format": "date-time"},
      "updated_at": {"type": "string", "format": "date-time"}
    },
    "additionalProperties": false
  }
}
